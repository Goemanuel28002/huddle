{
  "name": "@connect-together/desktop",
  "version": "0.2.1",
  "private": true,
  "description": "Connect Together desktop client",
  "author": "Connect Together contributors",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.connecttogether.desktop",
    "productName": "Connect Together",
    "directories": { "output": "release" },
    "files": ["main.cjs", "preload.cjs", "renderer/**/*", "assets/**/*"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "signExecutable": false,
      "icon": "assets/connect-together.ico",
      "artifactName": "Connect-Together-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Connect Together"
    }
  }
}
